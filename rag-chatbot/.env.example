# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
ENV=development

# ── Ollama ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3          # llama3 | mistral | llama3.1 | phi3
OLLAMA_EMBED_MODEL=nomic-embed-text   # best local embedding model
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1       # low = more factual
OLLAMA_TOP_K=40
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096          # context window

# ── RAG / ChromaDB ───────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=anurag_portfolio
RETRIEVAL_TOP_K=6            # chunks to retrieve per query
RETRIEVAL_MIN_SCORE=0.25     # minimum similarity score
CHUNK_SIZE=400               # tokens per chunk
CHUNK_OVERLAP=60             # overlap between chunks

# ── Embedding model ──────────────────────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2   # local fallback if no Ollama embed
EMBED_BATCH_SIZE=32

# ── Cache ─────────────────────────────────────────────────────
CACHE_DIR=./cache
CACHE_TTL=3600               # 1 hour
EMBED_CACHE_TTL=86400        # 24 hours

# ── Optional API fallback ─────────────────────────────────────
OPENAI_API_KEY=                # leave blank to disable
OPENAI_MODEL=gpt-3.5-turbo

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ── Candidate info ───────────────────────────────────────────
CANDIDATE_NAME=Anurag Swain
CANDIDATE_GITHUB=HUNTER-X0s
CANDIDATE_EMAIL=anurag.swain35@gmail.com
